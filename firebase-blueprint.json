      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombres": { "type": "string" },
        "apellidos": { "type": "string" },
        "dni": { "type": "string" },
        "fechaNacimiento": { "type": "string" },
        "nicknameRoblox": { "type": "string" },
        "grupoScout": { "type": "string" },
        "ciudad": { "type": "string" },
        "adultoId": { "type": "string" },
        "adultoNombre": { "type": "string" },
        "adultoAsp": { "type": "string" },
        "seisena": { "type": "string" },
        "permisoPadreAnexo4": { "type": "string" }
      },
      "required": ["id", "nombres", "apellidos", "dni", "adultoId"]
    }
  },
  "firestore": {
    "/adultos/{adultoId}": {
      "schema": "Adulto",
      "description": "Directorio de dirigentes scouts registrados"
    },
    "/lobatos/{lobatoId}": {
      "schema": "Lobato",
      "description": "Directorio de lobatos participantes"
    },
    "/documentos_anexos/{docId}": {
      "schema": "DocumentoAnexo",
      "description": "Metadatos de documentos y vouchers"
    }
  }
}

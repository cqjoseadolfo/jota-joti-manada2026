        "grupoScout": { "type": "string" },
        "cargo": { "type": "string" },
        "comisionStaff": { "type": "string" },
        "ciudad": { "type": "string" },
        "email": { "type": "string" },
        "celular": { "type": "string" },
        "nicknameRoblox": { "type": "string" },
        "dirigenteReferenteId": { "type": "string" },
        "dirigenteReferenteNombre": { "type": "string" },
        "dirigenteReferenteAsp": { "type": "string" },
        "archivoAnexo3": { "type": "string" },
        "archivoAnexo3Name": { "type": "string" },
        "archivoAnexo3Size": { "type": "string" },
        "voucherPago": { "type": "string" },
        "voucherPagoName": { "type": "string" },
        "voucherPagoSize": { "type": "string" },
        "fechaRegistro": { "type": "string" }
      },
      "required": ["id", "nombre", "registroAsp"]
